---
import { Image } from "astro:assets";

const { title, image } = Astro.props;
---

<section class="section section-hero my-5! relative">
  <div class="container">
    <div class="relative">
      {image ? (
        <Image
          src={image}
          alt=""
          width={1600}
          height={400}
          class="w-full h-[400px] object-cover"
        />
      ) : (
        <img
          src="/img/banners/hero-msi.jpg"
          alt=""
          class="w-full h-[400px] object-cover bg-neutral-800"
        />
      )}
      <div class="absolute inset-0 bg-black/50 flex items-center px-10">
        <h1 class="text-white text-4xl md:text-6xl lg:text-8xl font-bold uppercase">
          {title}
        </h1>
      </div>
    </div>
  </div>
</section>
