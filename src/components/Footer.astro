---
const today = new Date();
import Logo from "./Logo.astro";
import Socials from "./Socials.astro";
import { useTranslations } from "../i18n";
const locale = Astro.currentLocale;
const t = useTranslations(locale);

const navbar = [
  {
    links: [
      { url: "/blog", title: t({ fr: "Santé", en: "Health" }) },
      { url: "/blog", title: t({ fr: "Environnement", en: "Environment" }) },
      { url: "/blog", title: t({ fr: "Société", en: "Society" }) },
      { url: "/blog", title: t({ fr: "Technologie", en: "Technology" }) },
    ],
  },
  {
    links: [
      { url: "/blog", title: t({ fr: "Articles", en: "Articles" }) },
      { url: "/podcast", title: t({ fr: "Podcast", en: "Podcast" }) },
      { url: "/authors", title: t({ fr: "À propos", en: "About" }) },
    ],
  },
  {
    links: [
      { url: "#", title: t({ fr: "Infolettre", en: "Newsletter" }) },
      { url: "#", title: t({ fr: "Contact", en: "Contact" }) },
    ],
  },
];
---

<footer class="footer bg-black text-white pb-10 pt-5">
  <div class="footer-topline overflow-hidden uppercase flex gap-4 overflow-x-hidden w-full">
    {Array.from({ length: 100 }).map((_) => <span>{t({ fr: "Transfert de connaissances+++", en: "Knowledge transfer+++" })}</span>)}
  </div>
  <div class="footer-top w-full">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_auto] xl:grid-cols-[1fr_2fr] gap-10 items-center">
        <div>
          <h2 class="text-4xl sm:text-5xl uppercase font-bold">
            {t({ fr: "La science dans votre boîte courriel", en: "Science in your inbox" })}
          </h2>
        </div>
        <div>
          <form action="/" method="GET" class="flex flex-wrap gap-3 items-center md:ml-auto lg:max-w-sm">
            <input
              type="text"
              required
              name="subscribe_email"
              id="subscribe-email"
              placeholder={t({ fr: "Courriel", en: "Email" })}
              class="input text-black rounded-none flex-1"
            />
            <button class="btn bg-white rounded-none shadow-none hover:bg-neutral hover:text-white uppercase" type="submit">
              {t({ fr: "S'abonner", en: "Subscribe" })}
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
  <div class="footer-mdl w-full">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_3fr] gap-10">
        <div>
          <Logo />
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3">
          {navbar.map((item) => (
            <nav class="grid gap-0">
              {item.links.map((link) => (
                <a href={`/${locale}${link.url}`} class="hover:underline px-4 py-2">
                  {link.title}
                </a>
              ))}
            </nav>
          ))}
        </div>
      </div>
    </div>
  </div>
  <div class="footer-btm w-full">
    <div class="container flex flex-wrap gap-4 justify-between items-center">
      <p class="text-xs opacity-50">
        &copy; {today.getFullYear()} {t({ fr: "Mes Intérêts Sociaux — Propulsé par Astro", en: "My Social Interests — Powered by Astro" })}
      </p>
      <Socials />
    </div>
  </div>
</footer>