---
import Layout from "../../../layouts/Base.astro";
import Hero from "../../../components/Hero.astro";
import { getCollection } from "astro:content";
import { LOCALES, useTranslations } from "../../../i18n";

export async function getStaticPaths({ paginate }) {
  const allPosts = await getCollection("blog");
  const paths = [];

  for (const lang of Object.keys(LOCALES)) {
    const posts = allPosts.filter((post) => post.id.startsWith(`${lang}/`));
    const paginated = paginate(posts, {
      pageSize: 12,
      params: { lang },
    });
    paths.push(...paginated);
  }
  return paths;
}

const locale = Astro.params.lang;
const t = useTranslations(locale);
const { page } = Astro.props;
---

<Layout title={t({ fr: "Articles — Mes Intérêts Sociaux", en: "Articles — My Social Interests" })}>
  <Hero title={t({ fr: "Articles", en: "Articles" })} />

  <section class="mt-10">
    <div class="container flex flex-wrap justify-between items-center gap-4">
      <p class="font-semibold uppercase">{t({ fr: "Thématiques", en: "Topics" })}</p>
      <div class="flex flex-wrap items-center gap-4 justify-start">
        <a href={`/${locale}/blog`} class="btn btn-outline rounded-full py-1 px-4 h-auto hover:bg-black hover:text-white uppercase">{t({ fr: "Tous", en: "All" })}</a>
        <a href={`/${locale}/blog`} class="btn btn-outline rounded-full py-1 px-4 h-auto hover:bg-black hover:text-white uppercase">{t({ fr: "Santé", en: "Health" })}</a>
        <a href={`/${locale}/blog`} class="btn btn-outline rounded-full py-1 px-4 h-auto hover:bg-black hover:text-white uppercase">{t({ fr: "Environnement", en: "Environment" })}</a>
        <a href={`/${locale}/blog`} class="btn btn-outline rounded-full py-1 px-4 h-auto hover:bg-black hover:text-white uppercase">{t({ fr: "Société", en: "Society" })}</a>
        <a href={`/${locale}/blog`} class="btn btn-outline rounded-full py-1 px-4 h-auto hover:bg-black hover:text-white uppercase">{t({ fr: "Technologie", en: "Technology" })}</a>
      </div>
    </div>
  </section>

  <section class="section mt-5!">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 mb-10 gap-6">
        {page.data.map((post) => (
          <a href={`/${locale}/blog/${post.id.slice(locale.length + 1)}`} class="border p-6 hover:underline">
            <p class="text-xs uppercase opacity-50 mb-2">{post.data.pubDate.toLocaleDateString(locale === 'en' ? 'en-CA' : 'fr-CA')}</p>
            <h3 class="font-bold mb-2">{post.data.title}</h3>
            <p class="text-sm opacity-70">{post.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>