---
import Layout from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { LOCALES, useTranslations } from "../../../i18n";
import { render } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const paths = [];

  for (const lang of Object.keys(LOCALES)) {
    const posts = allPosts.filter((post) => post.id.startsWith(`${lang}/`));
    for (const post of posts) {
      paths.push({
        params: { lang, slug: post.id.slice(lang.length + 1) },
        props: { post, allPosts: posts },
      });
    }
  }
  return paths;
}

const locale = Astro.params.lang;
const t = useTranslations(locale);
const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);

const toc = headings.filter((h) => h.depth === 2);

const wordCount = (post.body ?? "").trim().split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(wordCount / 200));

const related = allPosts
  .filter((p) => p.id !== post.id)
  .slice(0, 2);
---

<Layout title={post.data.title} description={post.data.description}>
  <div id="reading-progress" class="fixed top-0 left-0 h-1 bg-black z-50" style="width:0%"></div>

  <section class="mt-10">
    <div class="container">
      <div class="flex items-center justify-between flex-wrap gap-4">
        <a
          href={`/${locale}/blog`}
          class="btn btn-link text-inherit uppercase no-underline group p-0"
        >
          <i class="fa-solid fa-arrow-left group-hover:translate-x-1"></i> {t({ fr: "Retour", en: "Back" })}
        </a>
        <p class="font-semibold text-3xl uppercase">{t({ fr: "Articles", en: "Articles" })}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 mb-10">
        <h1>{post.data.title}</h1>
        <p class="text-lg font-semibold">{post.data.description}</p>
      </div>
      <div class="flex flex-wrap gap-x-6 gap-y-3 items-center mb-5">
        <p>
          <b class="mr-2">{t({ fr: "Auteure", en: "Author" })}</b>
          <a href={`/${locale}/authors`}>Annick Bissainthe</a>
        </p>
        <p>
          <b class="mr-2">{t({ fr: "Date", en: "Date" })}</b>
          <span>{post.data.pubDate.toLocaleDateString(locale === 'en' ? 'en-CA' : 'fr-CA')}</span>
        </p>
        <p>
          <b class="mr-2">{t({ fr: "Lecture", en: "Reading time" })}</b>
          <span>{t({ fr: `${readingTime} min`, en: `${readingTime} min` })}</span>
        </p>
        <button
          id="share-btn"
          type="button"
          class="btn btn-outline rounded-full py-1 px-4 h-auto hover:bg-black hover:text-white uppercase ml-auto"
        >
          <i class="fa-solid fa-share-nodes"></i>
          <span id="share-label" data-copied={t({ fr: "Copié", en: "Copied" })}>{t({ fr: "Partager", en: "Share" })}</span>
        </button>
      </div>
    </div>
  </section>

  {post.data.heroImage && (
    <section class="mb-5">
      <div class="container">
        <Image
          src={post.data.heroImage}
          alt=""
          class="w-full h-auto max-h-[500px] object-cover"
        />
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_240px] gap-10 items-start">
        <div id="article-body" class="post max-w-3xl">
          <Content />

          {post.data.researchTitle && (
            <div class="border p-6 md:p-8 mt-10">
              <p class="text-xs uppercase opacity-50 mb-3 font-semibold">
                {t({ fr: "En savoir plus sur la recherche", en: "More on the research" })}
              </p>
              <h3 class="font-bold text-xl md:text-2xl mb-3">{post.data.researchTitle}</h3>
              {post.data.researchNote && (
                <p class="opacity-70 mb-4">{post.data.researchNote}</p>
              )}
              {post.data.researchCitation && (
                <p class="text-sm opacity-50">{post.data.researchCitation}</p>
              )}
              {post.data.researchUrl && (
                <a
                  href={post.data.researchUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-link text-inherit uppercase no-underline group p-0 mt-4"
                >
                  {t({ fr: "Consulter l'étude", en: "Read the study" })}
                  <i class="fa-solid fa-arrow-right group-hover:translate-x-1"></i>
                </a>
              )}
            </div>
          )}
        </div>

        <aside class="lg:sticky lg:top-10 grid gap-8">
          {toc.length > 0 && (
            <div>
              <p class="text-xs uppercase opacity-50 mb-3 font-semibold">
                {t({ fr: "Dans cet article", en: "In this article" })}
              </p>
              <ul id="toc" class="hidden lg:grid gap-2 border-l">
                {toc.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      data-toc-link
                      data-target={h.slug}
                      class="block pl-4 -ml-px border-l-2 border-transparent hover:border-black text-sm opacity-60 hover:opacity-100"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="border p-6">
            <p class="font-semibold uppercase mb-2">
              {t({ fr: "La science dans votre boîte courriel", en: "Science in your inbox" })}
            </p>
            <p class="text-sm opacity-70 mb-4">
              {t({ fr: "Un nouvel article chaque semaine, sans bruit.", en: "One new article a week, no noise." })}
            </p>
            <form action="/" method="GET" class="grid gap-2">
              <input
                type="email"
                required
                name="subscribe_email"
                placeholder={t({ fr: "Courriel", en: "Email" })}
                class="input input-bordered rounded-none w-full"
              />
              <button
                class="btn bg-black text-white rounded-none shadow-none hover:bg-neutral uppercase"
                type="submit"
              >
                {t({ fr: "S'abonner", en: "Subscribe" })}
              </button>
            </form>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="border-t pt-8">
          <p class="font-semibold uppercase mb-6">{t({ fr: "À lire ensuite", en: "Read next" })}</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {related.map((p) => (
              <a href={`/${locale}/blog/${p.id.slice(locale.length + 1)}`} class="border p-6 hover:underline">
                <p class="text-xs uppercase opacity-50 mb-2">
                  {p.data.pubDate.toLocaleDateString(locale === 'en' ? 'en-CA' : 'fr-CA')}
                </p>
                <h3 class="font-bold mb-2">{p.data.title}</h3>
                <p class="text-sm opacity-70">{p.data.description}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}
</Layout>

<script>
  function onScroll() {
    const el = document.getElementById("article-body");
    const bar = document.getElementById("reading-progress");
    if (!el || !bar) return;
    const rect = el.getBoundingClientRect();
    const total = rect.height - window.innerHeight;
    const scrolled = Math.min(Math.max(-rect.top, 0), Math.max(total, 1));
    const pct = total > 0 ? (scrolled / total) * 100 : 0;
    bar.style.width = `${pct}%`;
  }
  document.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const links = Array.from(document.querySelectorAll("[data-toc-link]"));
  const targets = links
    .map((l) => document.getElementById(l.getAttribute("data-target")))
    .filter(Boolean);

  if ("IntersectionObserver" in window && targets.length) {
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const link = document.querySelector(`[data-target="${entry.target.id}"]`);
          if (!link) return;
          if (entry.isIntersecting) {
            links.forEach((l) => {
              l.classList.remove("opacity-100", "border-black");
              l.classList.add("opacity-60", "border-transparent");
            });
            link.classList.remove("opacity-60", "border-transparent");
            link.classList.add("opacity-100", "border-black");
          }
        });
      },
      { rootMargin: "-20% 0px -70% 0px" }
    );
    targets.forEach((t) => obs.observe(t));
  }

  const shareBtn = document.getElementById("share-btn");
  const shareLabel = document.getElementById("share-label");
  shareBtn?.addEventListener("click", async () => {
    const original = shareLabel?.textContent;
    try {
      await navigator.clipboard.writeText(location.href);
    } catch (e) {
      // clipboard unavailable, still show feedback
    }
    if (shareLabel) {
      shareLabel.textContent = shareLabel.dataset.copied || "Copié";
      setTimeout(() => {
        if (shareLabel && original) shareLabel.textContent = original;
      }, 1600);
    }
  });
</script>
