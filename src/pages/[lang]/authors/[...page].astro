---
import Layout from "../../../layouts/Base.astro";
import Hero from "../../../components/Hero.astro";
import { LOCALES, useTranslations } from "../../../i18n";

export const getStaticPaths = () =>
  Object.keys(LOCALES).map((lang) => ({
    params: { lang },
  }));

const locale = Astro.params.lang;
const t = useTranslations(locale);
---

<Layout title={t({ fr: "À propos — Mes Intérêts Sociaux", en: "About — My Social Interests" })}>
  <Hero title={t({ fr: "La Fondatrice", en: "The Founder" })} />

  <section class="section">
    <div class="container">
      <div class="max-w-3xl mx-auto py-10">
        <h2>Annick Bissainthe</h2>
        <p class="text-lg font-semibold my-6">
          {t({
            fr: "Chercheuse en transfert de connaissances et fondatrice de Mes Intérêts Sociaux — une plateforme dédiée à rendre la science utile, compréhensible et accessible à tous.",
            en: "Knowledge transfer researcher and founder of My Social Interests — a platform dedicated to making science useful, understandable, and accessible to everyone.",
          })}
        </p>
        <p class="my-4">
          {t({
            fr: "L'information circule vite, mais rarement bien. Les algorithmes amplifient la colère. Les études scientifiques deviennent des armes dans les débats. Le savoir reste confiné dans les cercles académiques pendant que le public navigue seul dans le bruit.",
            en: "Information travels fast, but rarely well. Algorithms amplify anger. Scientific studies become weapons in debates. Knowledge stays confined to academic circles while the public navigates the noise alone.",
          })}
        </p>
        <p class="my-4">
          {t({
            fr: "Annick ne parachute pas des vérités absolues. Elle ouvre le capot : elle sélectionne des recherches publiques rigoureuses, décortique leur méthode, leurs forces et leurs limites — et les traduit en insights concrets pour le quotidien.",
            en: "Annick doesn't hand down absolute truths. She opens the hood: she selects rigorous public research, breaks down its methodology, its strengths and its limits — and translates it into concrete insights for everyday life.",
          })}
        </p>
        <p class="my-4">
          {t({
            fr: "Ni journalisme d'opinion, ni vulgarisation superficielle. Une lecture honnête et rigoureuse de ce que la science nous apprend, pour reprendre le contrôle de notre rapport à l'information.",
            en: "Neither opinion journalism nor superficial pop-science. An honest, rigorous look at what science actually tells us, so we can take back control of our relationship with information.",
          })}
        </p>
      </div>
    </div>
  </section>
</Layout>
